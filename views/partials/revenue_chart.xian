<!-- Revenue chart -->
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-base font-semibold text-slate-950">Revenue overview</h3>
                  <span class="rounded-full bg-emerald-50 px-2 py-1 text-[11px] font-semibold text-emerald-700">+12.8%</span>
                </div>
                <p class="mt-1 text-sm text-slate-500">Your revenue performance over the last 7 days.</p>
              </div>

              <div class="flex items-center gap-4 text-xs text-slate-500">
                <span class="flex items-center gap-2">
                  <span class="h-2 w-2 rounded-full bg-slate-900"></span>
                  Revenue
                </span>
                <button class="font-medium text-slate-700 hover:text-slate-950">View report →</button>
              </div>
            </div>

            <div class="mt-8">
              <!-- Chart area -->
              <div class="flex h-64 gap-4 sm:h-72">
                <!-- Y axis -->
                <div class="flex w-10 flex-col justify-between pb-7 text-right text-[11px] font-medium text-slate-400">
                  <span>$20k</span>
                  <span>$15k</span>
                  <span>$10k</span>
                  <span>$5k</span>
                  <span>$0</span>
                </div>

                <!-- Plot -->
                <div class="relative min-w-0 flex-1">
                  <!-- Grid -->
                  <div class="pointer-events-none absolute inset-x-0 top-0 h-[calc(100%-28px)]">
                    <div class="absolute inset-x-0 top-0 border-t border-dashed border-slate-200"></div>
                    <div class="absolute inset-x-0 top-1/4 border-t border-dashed border-slate-200"></div>
                    <div class="absolute inset-x-0 top-2/4 border-t border-dashed border-slate-200"></div>
                    <div class="absolute inset-x-0 top-3/4 border-t border-dashed border-slate-200"></div>
                    <div class="absolute inset-x-0 bottom-0 border-t border-slate-200"></div>
                  </div>

                  <!-- SVG line chart -->
                  <svg
                    viewBox="0 0 700 250"
                    class="absolute inset-x-0 top-0 h-[calc(100%-28px)] w-full overflow-visible"
                    role="img"
                    aria-label="Revenue line chart"
                    preserveAspectRatio="none"
                  >
                    <defs>
                      <linearGradient id="revenueFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#0f172a" stop-opacity="0.12"></stop>
                        <stop offset="100%" stop-color="#0f172a" stop-opacity="0"></stop>
                      </linearGradient>
                    </defs>

                    <path
                      d="M0 202 C58 189, 63 170, 116 179 S165 154, 204 163 S257 125, 306 142 S351 168, 402 137 S462 112, 510 123 S563 87, 611 101 S661 65, 700 74 L700 250 L0 250 Z"
                      fill="url(#revenueFill)"
                    />

                    <path
                      d="M0 202 C58 189, 63 170, 116 179 S165 154, 204 163 S257 125, 306 142 S351 168, 402 137 S462 112, 510 123 S563 87, 611 101 S661 65, 700 74"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                      vector-effect="non-scaling-stroke"
                      class="text-slate-900"
                    />

                    <circle cx="700" cy="74" r="5" fill="white" stroke="#0f172a" stroke-width="3"></circle>
                  </svg>

                  <!-- X axis -->
                  <div class="absolute inset-x-0 bottom-0 flex justify-between text-[11px] font-medium text-slate-400">
                    <span>Mon</span>
                    <span>Tue</span>
                    <span>Wed</span>
                    <span>Thu</span>
                    <span>Fri</span>
                    <span>Sat</span>
                    <span>Sun</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Bottom stats -->
            <div class="mt-6 grid grid-cols-1 divide-y divide-slate-100 border-t border-slate-100 pt-5 sm:grid-cols-3 sm:divide-x sm:divide-y-0">
              <div class="py-2 sm:px-4 sm:py-0 first:sm:pl-0">
                <p class="text-xs font-medium text-slate-500">Today</p>
                <p class="mt-1 text-sm font-bold text-slate-950">$11,284</p>
              </div>
              <div class="py-2 sm:px-4 sm:py-0">
                <p class="text-xs font-medium text-slate-500">Average order</p>
                <p class="mt-1 text-sm font-bold text-slate-950">$56.84</p>
              </div>
              <div class="py-2 sm:px-4 sm:py-0">
                <p class="text-xs font-medium text-slate-500">Projected</p>
                <p class="mt-1 text-sm font-bold text-slate-950">$91,620</p>
              </div>
            </div>
          </article>