<!-- KPI cards -->
        <section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <!-- Revenue -->
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-sm font-medium text-slate-500">Total revenue</p>
                <p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">$84,240</p>
              </div>
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
                <i data-lucide="wallet" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="mt-5 flex items-center gap-2 text-xs">
              <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2 py-1 font-semibold text-emerald-700">
                <i data-lucide="trending-up" class="h-3.5 w-3.5"></i>
                12.8%
              </span>
              <span class="text-slate-400">vs. previous week</span>
            </div>
          </article>

          <!-- Orders -->
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-sm font-medium text-slate-500">Orders</p>
                <p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">1,482</p>
              </div>
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-blue-50 text-blue-600">
                <i data-lucide="shopping-cart" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="mt-5 flex items-center gap-2 text-xs">
              <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-1 font-semibold text-blue-700">
                <i data-lucide="trending-up" class="h-3.5 w-3.5"></i>
                8.4%
              </span>
              <span class="text-slate-400">vs. previous week</span>
            </div>
          </article>

          <!-- Customers -->
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-sm font-medium text-slate-500">Customers</p>
                <p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">12,640</p>
              </div>
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-violet-50 text-violet-600">
                <i data-lucide="users-round" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="mt-5 flex items-center gap-2 text-xs">
              <span class="inline-flex items-center gap-1 rounded-full bg-violet-50 px-2 py-1 font-semibold text-violet-700">
                <i data-lucide="trending-up" class="h-3.5 w-3.5"></i>
                5.6%
              </span>
              <span class="text-slate-400">vs. previous week</span>
            </div>
          </article>

          <!-- Conversion -->
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft">
            <div class="flex items-start justify-between">
              <div>
                <p class="text-sm font-medium text-slate-500">Conversion rate</p>
                <p class="mt-2 text-2xl font-bold tracking-tight text-slate-950">4.28%</p>
              </div>
              <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-50 text-amber-600">
                <i data-lucide="percent" class="h-5 w-5"></i>
              </div>
            </div>
            <div class="mt-5 flex items-center gap-2 text-xs">
              <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2 py-1 font-semibold text-rose-600">
                <i data-lucide="trending-down" class="h-3.5 w-3.5"></i>
                1.2%
              </span>
              <span class="text-slate-400">vs. previous week</span>
            </div>
          </article>
        </section>