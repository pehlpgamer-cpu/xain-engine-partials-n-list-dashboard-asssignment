<!-- Top products -->
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-soft sm:p-6">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h3 class="text-base font-semibold text-slate-950">Top products</h3>
                <p class="mt-1 text-sm text-slate-500">Best-performing products this week.</p>
              </div>
              <a href="#" class="text-sm font-semibold text-slate-900 hover:underline">View products</a>
            </div>

            <div class="mt-5 overflow-x-auto">
              <table class="w-full min-w-[560px] text-left text-sm">
                <thead>
                  <tr class="border-b border-slate-100 text-xs font-semibold uppercase tracking-wider text-slate-400">
                    <th class="pb-3 pr-4">Product</th>
                    <th class="pb-3 px-4">Orders</th>
                    <th class="pb-3 px-4">Revenue</th>
                    <th class="pb-3 pl-4 text-right">Trend</th>
                  </tr>
                </thead>
                <!-- Handlebars template: top products -->
                
                  {{#each topProducts}}
                    <tr>
                      <td class="py-4 pr-4">
                        <div class="flex items-center gap-3">
                          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-slate-100">
                            <i data-lucide="{{this.icon}}" class="h-5 w-5 text-slate-700"></i>
                          </div>
                          <div>
                            <p class="font-semibold text-slate-900">{{this.name}}</p>
                            <p class="text-xs text-slate-500">{{this.category}}</p>
                          </div>
                        </div>
                      </td>
                      <td class="px-4 py-4 font-medium text-slate-700">{{this.orders}}</td>
                      <td class="px-4 py-4 font-semibold text-slate-900">{{this.revenue}}</td>
                      <td class="py-4 pl-4 text-right">
                        {{#if this.trendUp}}
                          <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-600">
                            <i data-lucide="trending-up" class="h-3.5 w-3.5"></i> {{this.trend}}
                          </span>
                        {{else}}
                          <span class="inline-flex items-center gap-1 text-xs font-semibold text-rose-600">
                            <i data-lucide="trending-down" class="h-3.5 w-3.5"></i> {{this.trend}}
                          </span>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                

                <tbody id="topProductsTableBody" class="divide-y divide-slate-100"></tbody>
              </table>
            </div>
          </article>