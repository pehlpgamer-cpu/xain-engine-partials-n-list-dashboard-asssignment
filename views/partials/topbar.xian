<!-- Topbar -->
      <header class="sticky top-0 z-30 flex h-20 items-center border-b border-slate-200 bg-white/90 px-4 backdrop-blur-md sm:px-6 lg:px-8">
        <div class="flex min-w-0 flex-1 items-center gap-3">
          <button
            id="openSidebar"
            type="button"
            class="rounded-xl border border-slate-200 p-2.5 text-slate-600 hover:bg-slate-50 lg:hidden"
            aria-label="Open sidebar"
          >
            <i data-lucide="menu" class="h-5 w-5"></i>
          </button>

          <div class="min-w-0">
            <p class="text-xs font-medium text-slate-500">Monday, September 20, 2026</p>
            <h1 class="truncate text-lg font-semibold tracking-tight text-slate-950 sm:text-xl">
              Good evening, Jordan
            </h1>
          </div>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
          <!-- Search -->
          <label class="relative hidden md:block">
            <span class="sr-only">Search</span>
            <i data-lucide="search" class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400"></i>
            <input
              type="search"
              placeholder="Search..."
              class="h-10 w-52 rounded-xl border border-slate-200 bg-slate-50 pl-9 pr-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-slate-400 focus:bg-white focus:ring-4 focus:ring-slate-100 lg:w-64"
            />
          </label>

          <button
            type="button"
            class="rounded-xl border border-slate-200 p-2.5 text-slate-600 transition hover:bg-slate-50 hover:text-slate-950"
            aria-label="Search"
          >
            <i data-lucide="search" class="h-5 w-5 md:hidden"></i>
          </button>

          <button
            type="button"
            class="relative rounded-xl border border-slate-200 p-2.5 text-slate-600 transition hover:bg-slate-50 hover:text-slate-950"
            aria-label="Notifications"
          >
            <i data-lucide="bell" class="h-5 w-5"></i>
            <span class="absolute right-2 top-2 h-2 w-2 rounded-full bg-rose-500 ring-2 ring-white"></span>
          </button>

          <button
            type="button"
            class="hidden h-10 items-center gap-2 rounded-xl bg-slate-900 px-3.5 text-sm font-semibold text-white transition hover:bg-slate-800 sm:inline-flex"
          >
            <i data-lucide="plus" class="h-4 w-4"></i>
            Create
          </button>
        </div>
      </header>